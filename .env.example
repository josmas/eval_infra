# Copy to .env and fill in real values:  cp .env.example .env
# Generate random secrets with: openssl rand -hex 32   (or -hex 16 for shorter ones)
#
# Nothing in this file should ever be committed with real values.

# ---------------------------------------------------------------------------
# Langfuse (self-hosted) - core secrets
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
SALT=
ENCRYPTION_KEY=
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
NEXTAUTH_SECRET=

# MinIO root password. Reuse the SAME value for the three S3 upload secret
# keys below - Langfuse's S3 client auths against MinIO using these as
# access-key/secret-key pairs (access key id stays the default "minio").
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Langfuse (self-hosted) - auto-provisioning on first boot
# Lets `docker compose up` create an org/project/user + fixed API keys
# without clicking through the web UI. Pick any ids/names/password; the
# public/secret key pair below is what LiteLLM will use to send traces.
# ---------------------------------------------------------------------------
LANGFUSE_INIT_ORG_ID=eval-infra
LANGFUSE_INIT_ORG_NAME=Eval Infra
LANGFUSE_INIT_PROJECT_ID=eval-infra
LANGFUSE_INIT_PROJECT_NAME=eval-infra
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGEME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGEME
LANGFUSE_INIT_USER_EMAIL=
LANGFUSE_INIT_USER_NAME=
LANGFUSE_INIT_USER_PASSWORD=

# ---------------------------------------------------------------------------
# LiteLLM proxy
# ---------------------------------------------------------------------------
# Only used to mint/manage virtual keys via /key/generate - never hand this
# to a consumer.
LITELLM_MASTER_KEY=sk-CHANGEME
# Encrypts provider credentials at rest. Changing this later makes existing
# encrypted credentials unreadable, so pick it once and keep it.
LITELLM_SALT_KEY=

# Cloud provider credentials (leave blank for any provider you're not using).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# AWS Bedrock - long-lived IAM access key (not an SSO profile - see README).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=eu-west-1

# ---------------------------------------------------------------------------
# Blockly plugin backend (Fastify)
# ---------------------------------------------------------------------------
# Virtual key minted from LiteLLM for this backend specifically (see README
# "Bootstrap" section - you can't fill this in until litellm has started
# once). Scope its allowed models/budget however you want the plugin capped.
PLUGIN_LITELLM_VIRTUAL_KEY=

# Comma-separated list of keys the plugin itself presents to this backend
# (one per install, or a single shared dev key for now). Not a LiteLLM key.
PLUGIN_API_KEYS=
